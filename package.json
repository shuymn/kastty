{
  "name": "kastty",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "fmt": "biome format --fix .",
    "typecheck": "tsc --noEmit",
    "test": "bun test web",
    "build:web": "bun web/build.ts",
    "check": "biome check --fix . && bun run typecheck && bun test web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.2",
    "lefthook": "2.1.17"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6.0.0"
  },
  "dependencies": {
    "@fontsource-variable/m-plus-1-code": "^5.2.9",
    "ghostty-web": "^0.4.0"
  }
}
