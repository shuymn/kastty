{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>shuymn/github-actions#main"],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update FONTTOOLS_VERSION in update-nerd-font.sh",
      "managerFilePatterns": ["scripts/update-nerd-font.sh"],
      "matchStrings": ["FONTTOOLS_VERSION=\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "fonttools",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Update BROTLI_VERSION in update-nerd-font.sh",
      "managerFilePatterns": ["scripts/update-nerd-font.sh"],
      "matchStrings": ["BROTLI_VERSION=\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "brotli",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Update NERD_FONTS_VERSION in update-nerd-font.sh",
      "managerFilePatterns": ["scripts/update-nerd-font.sh"],
      "matchStrings": ["NERD_FONTS_VERSION=\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "ryanoasis/nerd-fonts",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update MISE_VERSION, the mise release jdx/mise-action installs",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["MISE_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "The flake's ghostty input follows GHOSTTY_COMMIT, which follows go-libghostty",
      "matchManagers": ["nix"],
      "matchDepNames": ["ghostty"],
      "enabled": false
    },
    {
      "description": "GHOSTTY_COMMIT in scripts/libghostty-vt.sh must follow go-libghostty's pinned ghostty commit; `make lint` fails until they match",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["go.mitchellh.com/libghostty"],
      "prBodyNotes": [
        "Set `GHOSTTY_COMMIT` in `scripts/libghostty-vt.sh` and the `ghostty` input in `flake.nix` to the `GIT_TAG` in go-libghostty's `CMakeLists.txt` at the new version, and run `nix flake lock`, before merging."
      ]
    },
    {
      "description": "Update the Bun pin in mise.toml together with @types/bun, as the shared preset does for .bun-version",
      "matchManagers": ["mise"],
      "matchDepNames": ["bun"],
      "groupName": "bun",
      "groupSlug": "bun"
    },
    {
      "description": "Zig releases are tagged on Codeberg. Stay on the minor version ghostty's build.zig.zon requires; raise the cap when GHOSTTY_COMMIT moves to a newer Zig",
      "matchManagers": ["mise"],
      "matchDepNames": ["zig"],
      "overrideDatasource": "forgejo-tags",
      "overridePackageName": "ziglang/zig",
      "registryUrls": ["https://codeberg.org"],
      "allowedVersions": "<0.17.0"
    }
  ]
}
